@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CarGo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />    

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-control {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff !important; /* force input text to white */
            border-radius: 10px;
        }

            /* Make placeholder text white too */
            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }


        .login-popup {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            border-radius: 15px;
            padding: 40px 30px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            text-align: center;
        }

            .login-popup h2 {
                color: #0fc0fc;
                margin-bottom: 20px;
            }

        .form-control {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            border-radius: 10px;
            color: #fff;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.25);
                box-shadow: 0 0 8px #0fc0fc;
                outline: none;
            }

        .btn-login {
            background-color: #0fc0fc;
            border: none;
            color: #0B1225;
            font-weight: bold;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-login:hover {
                transform: scale(1.05);
                box-shadow: 0 0 15px #0fc0fc;
            }

        .extra-links {
            margin-top: 15px;
            font-size: 0.9em;
        }

            .extra-links a {
                color: #0fc0fc;
                text-decoration: none;
            }

                .extra-links a:hover {
                    text-decoration: underline;
                }

        .alert-danger {
            background-color: rgba(255,0,0,0.2);
            border: 1px solid red;
            color: white;
        }

        .alert-success {
            background-color: rgba(0, 255, 0, 0.2);
            border: 1px solid #0fc0fc;
            color: white;
            margin-bottom: 15px;
        }

        .btn-home {
            background-color: #0fc0fc;
            border: none;
            color: #0B1225;
            font-weight: bold;
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 15px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-home:hover {
                transform: scale(1.05);
                box-shadow: 0 0 15px #0fc0fc;
            }

    </style>
</head>
<body>
    <div class="login-popup">
        <!-- ✅ Home button -->
        <a asp-controller="Home" asp-action="Index" class="btn-home d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-house-fill"></i> Home
        </a>

        <h2>Login</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" id="successMsg">
                @TempData["SuccessMessage"]
            </div>
            <script>
                // Hide message after 3 seconds
                setTimeout(function () {
                    document.getElementById("successMsg").style.display = "none";
                    document.getElementById("email").focus(); // focus on email input
                }, 3000);
            </script>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3 text-start">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <div class="mb-3 text-start">
                <label for="password" class="form-label">Password</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="password" name="password" required>
                    <span class="input-group-text bg-transparent text-white" style="cursor:pointer;" id="togglePassword">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </span>
                </div>
            </div>

            <button type="submit" class="btn-login">Login</button>

            <hr style="margin:20px 0; border-color: rgba(255,255,255,0.2);" />

            <!-- ✅ Continue with Google -->
            <a asp-controller="Account" asp-action="GoogleLogin" class="btn btn-light w-100 d-flex align-items-center justify-content-center" style="border-radius: 10px; padding: 10px; font-weight: bold; gap: 10px;">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" style="width:20px; height:20px;" />
                Continue with Google
            </a>

            <div class="extra-links">
                <p>Don't have an account? <a asp-controller="Account" asp-action="Signup">Sign Up</a></p>
            </div>

        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const togglePassword = document.getElementById("togglePassword");
        const passwordInput = document.getElementById("password");
        const eyeIcon = document.getElementById("eyeIcon");

        togglePassword.addEventListener("click", function () {
            const isPassword = passwordInput.type === "password";
            passwordInput.type = isPassword ? "text" : "password";
            eyeIcon.classList.toggle("bi-eye");
            eyeIcon.classList.toggle("bi-eye-slash");
        });
    </script>
</body>
</html>

