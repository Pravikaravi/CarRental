@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CarGo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .signup-container {
            background: rgba(255, 255, 255, 0.05);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            width: 400px;
            text-align: center;
        }

            .signup-container h2 {
                color: #0fc0fc;
                margin-bottom: 20px;
            }

        .form-control {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            border-radius: 10px;
        }

            .form-control:focus {
                background: rgba(0, 0, 0, 0.5);
                border-color: #0fc0fc;
                box-shadow: 0 0 8px #0fc0fc;
                outline: none;
            }

        .btn-signup {
            background-color: #0fc0fc;
            border: none;
            color: #0B1225;
            font-weight: bold;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-signup:hover {
                transform: scale(1.05);
                box-shadow: 0 0 15px #0fc0fc;
            }

        a {
            color: #0fc0fc;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }

        .alert-danger {
            background-color: rgba(255,0,0,0.2);
            border: 1px solid red;
            color: white;
        }
    </style>
</head>
<body>
    <div class="signup-container">
        <h2><i class="fas fa-user-plus"></i> Sign Up</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Signup" method="post">
            @if (ViewBag.ShowOtpForm == true)
            {
                <div class="mb-3 text-start">
                    <label for="otpInput" class="form-label">Enter OTP</label>
                    <input type="text" class="form-control" name="otpInput" id="otpInput" required />
                </div>
                <button type="submit" class="btn-signup">Verify OTP</button>
            }
            else
            {
                <div class="mb-3 text-start">
                    <label for="email" class="form-label">Email address</label>
                    <input type="email" class="form-control" name="email" id="email" required />
                </div>
                <div class="mb-3 text-start">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" name="password" id="password" required />
                </div>
                <div class="mb-3 text-start">
                    <label for="confirmPassword" class="form-label">Confirm Password</label>
                    <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" required />
                </div>
                <button type="submit" class="btn-signup">Send OTP</button>
            }
        </form>

        <p class="mt-3">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Login</a>
        </p>
    </div>
</body>
</html>
