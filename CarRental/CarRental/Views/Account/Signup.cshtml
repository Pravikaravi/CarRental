@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CarGo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }



        .signup-container {
            background: rgba(255, 255, 255, 0.05);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            width: 400px;
            text-align: center;
        }

            .signup-container h2 {
                color: #0fc0fc;
                margin-bottom: 20px;
            }


        .form-control {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff; 
            border-radius: 10px;
        }


            .form-control:focus {
                background: rgba(0, 0, 0, 0.5);
                border-color: #0fc0fc;
                box-shadow: 0 0 8px #0fc0fc;
                outline: none;
            }

        .btn-signup {
            background-color: #0fc0fc;
            border: none;
            color: #0B1225;
            font-weight: bold;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-signup:hover {
                transform: scale(1.05);
                box-shadow: 0 0 15px #0fc0fc;
            }

        a {
            color: #0fc0fc;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }

        .alert-danger {
            background-color: rgba(255,0,0,0.2);
            border: 1px solid red;
            color: white;
        }

        .btn-home {
            background-color: #0fc0fc;
            border: none;
            color: #0B1225;
            font-weight: bold;
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 15px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-home:hover {
                transform: scale(1.05);
                box-shadow: 0 0 15px #0fc0fc;
            }

            .form-control {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff !important; /* force input text to white */
    border-radius: 10px;
}

/* Make placeholder text white too */
.form-control::placeholder {
    color: rgba(255, 255, 255, 0.7);
}


    </style>
</head>
<body>
    <div class="signup-container">
        <!-- ✅ Home button -->
        <a asp-controller="Home" asp-action="Index" class="btn-home d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-house-fill"></i> Home
        </a>
        <h2><i class="fas fa-user-plus"></i> Sign Up</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Signup" method="post">
            @if (ViewBag.ShowOtpForm == true)
            {
                <div class="mb-3 text-start">
                    <label for="otpInput" class="form-label">Enter OTP</label>
                    <input type="text" class="form-control" name="otpInput" id="otpInput" required />
                </div>
                <button type="submit" class="btn-signup">Verify OTP</button>
            }
            else
            {
                <div class="mb-3 text-start">
    <label for="email" class="form-label">Email address</label>
    <input type="email" class="form-control" name="email" id="email" required />
</div>

<div class="mb-3 text-start">
    <label for="password" class="form-label">Password</label>
    <div class="input-group">
        <input type="password" class="form-control" name="password" id="password"
               pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,}" 
               title="Password must be at least 6 characters, include uppercase, lowercase, and a number" 
               required />
        <span class="input-group-text bg-transparent text-white" style="cursor:pointer;" id="togglePassword">
            <i class="bi bi-eye" id="eyeIcon1"></i>
        </span>
    </div>
</div>

<div class="mb-3 text-start">
    <label for="confirmPassword" class="form-label">Confirm Password</label>
    <div class="input-group">
        <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" required />
        <span class="input-group-text bg-transparent text-white" style="cursor:pointer;" id="toggleConfirmPassword">
            <i class="bi bi-eye" id="eyeIcon2"></i>
        </span>
    </div>
</div>


<button type="submit" class="btn-signup">Send OTP</button>

            }
        </form>

        <p class="mt-3">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Login</a>
        </p>
    </div>
    <script>
    function setupToggle(inputId, toggleId, iconId) {
        const toggle = document.getElementById(toggleId);
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        toggle.addEventListener("click", function () {
            const isPassword = input.type === "password";
            input.type = isPassword ? "text" : "password";
            icon.classList.toggle("bi-eye");
            icon.classList.toggle("bi-eye-slash");
        });
    }

    // Setup for both fields
    setupToggle("password", "togglePassword", "eyeIcon1");
    setupToggle("confirmPassword", "toggleConfirmPassword", "eyeIcon2");
</script>

</body>
</html>
