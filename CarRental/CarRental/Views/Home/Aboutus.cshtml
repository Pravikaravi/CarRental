@{
    ViewData["Title"] = "About Us";
    Layout = null; // standalone page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Car Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #f8f9fa;
            min-height: 100vh;
        }

        .about-section {
            padding: 60px 20px;
        }

        .about-title {
            color: #0fc0fc;
            font-weight: bold;
        }

        .about-list li {
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

            .about-list li::before {
                content: "✔ ";
                color: #0fc0fc;
                font-weight: bold;
            }

        .about-img {
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }
    </style>
</head>
<body>
    <div class="container about-section">
        <div class="row align-items-center">
            <!-- Left content -->
            <div class="col-md-6 mb-4 mb-md-0">
                <h2 class="about-title mb-4">About Our Car Rental Service</h2>
                <p>
                    Welcome to <strong>Car Rental Management System</strong>!
                    We are dedicated to providing <span class="text-info fw-bold">reliable, affordable,</span>
                    and well-maintained vehicles for all your travel needs.
                </p>
                <p>
                    Whether you are planning a family vacation, a business trip,
                    or just need a car for a few days, we ensure a smooth and hassle-free rental experience.
                </p>
                <ul class="about-list list-unstyled">
                    <li>Wide range of cars available</li>
                    <li>Affordable daily rates</li>
                    <li>Easy booking system</li>
                    <li>24/7 customer support</li>
                </ul>
            </div>

            <!-- Right image -->
            <div class="col-md-6 text-center">
                <img src="~/images/BMWBlack.png" class="img-fluid about-img" alt="Car Rental" />
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

