@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Layout = null; // standalone page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CarGo Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #f8f9fa;
            min-height: 100vh;
        }

        .about-section {
            padding: 80px 20px;
        }

        .about-title {
            color: #0fc0fc;
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 30px;
        }

        .about-text p {
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .about-list li {
            margin-bottom: 15px;
            font-size: 1.1rem;
            position: relative;
            padding-left: 25px;
        }

            .about-list li::before {
                content: "✔";
                color: #0fc0fc;
                font-weight: bold;
                position: absolute;
                left: 0;
                top: 0;
            }

        .about-img {
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }

            .about-img:hover {
                transform: scale(1.05);
            }

        .card-highlight {
            background: rgba(15, 192, 252, 0.1);
            border-left: 5px solid #0fc0fc;
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
        }

        @@media (max-width: 767px) {
            .about-title

        {
            font-size: 2rem;
        }

        }
    </style>
</head>
<body>
    <div class="container about-section">
        <div class="row align-items-center">
            <!-- Left content -->
            <div class="col-md-6 mb-4 mb-md-0 about-text">
                <h2 class="about-title">About <span class="text-info">CarGo Rental</span></h2>
                <p>
                    Welcome to <strong>CarGo Rental</strong>! We are committed to providing
                    <span class="fw-bold text-info">reliable, affordable,</span> and top-quality vehicles for all your travel needs.
                </p>
                <p>
                    Whether it's a family vacation, business trip, or a quick ride, we ensure a seamless and hassle-free rental experience.
                </p>

                <div class="card-highlight">
                    <ul class="about-list list-unstyled mb-0">
                        <li>Wide range of cars for every occasion</li>
                        <li>Competitive daily rates</li>
                        <li>Easy and fast booking system</li>
                        <li>24/7 dedicated customer support</li>
                    </ul>
                </div>
            </div>

            <!-- Right image -->
            <div class="col-md-6 text-center">
                <!-- Razor-friendly image path -->
                <img src="@Url.Content("~/images/BMWBlack.png")" class="img-fluid about-img" alt="Car Rental" />
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
