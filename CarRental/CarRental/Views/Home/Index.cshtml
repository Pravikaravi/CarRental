@model IEnumerable<CarRental.Models.Car>
@Html.AntiForgeryToken()

@{
    // Get current user email for existing customer detection
    var currentUserEmail = User.Identity?.Name ?? "";
}

<input type="hidden" id="currentUserEmail" value="@currentUserEmail" />

<!-- Carousel -->
<div id="bannerCarousel" class="carousel slide container mt-4" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/Images/Pravi1.jpg" class="d-block w-100" alt="Banner 1" style="height: 300px; object-fit: cover;">
        </div>
        <div class="carousel-item">
            <img src="~/Images/Pravi2.jpg" class="d-block w-100" alt="Banner 1" style="height: 300px; object-fit: cover;">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>


<!-- Car Cards -->
<div class="car-container" id="carMenu" style="margin-top: 50px;">
    @foreach (var car in Model)
    {
        <div class="car-card" data-brand="@car.CarBrand" data-model="@car.CarName">
            <img src="@car.ImageUrl" alt="@car.CarName" />
            <h3>@car.CarName</h3>
            <p>@car.CarBrand • @car.CarSeats Seats • @car.CarStatus</p>
            <div class="price-rating">
                <span class="price">LKR @car.CarRentalAmount/day</span>
                <div class="rating"><i class="fas fa-star"></i><span>4.5</span></div>
            </div>
            <button type="button" class="book-btn"
                    onclick="console.log('Book button clicked for @car.CarName'); openBookingModal('@car.Id', '@car.CarName', '@car.CarBrand', '@car.CarRentalAmount')">
                Book
            </button>

        </div>
    }
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #2d2d2d !important; color: #ffffff !important; border: 1px solid #404040 !important;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important; border-bottom: 1px solid #404040 !important;">
                <h5 class="modal-title" id="bookingModalLabel" style="color: white !important;">🚗 Book Your Car</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1) !important;"></button>
            </div>
            <div class="modal-body" style="background: #2d2d2d !important; color: #ffffff !important;">
                <div class="car-details mb-4 p-3 rounded" style="background: var(--tertiary-bg); border: 1px solid var(--border-color);">
                    <h6 id="selectedCarName" class="text-primary mb-2"></h6>
                    <p id="selectedCarBrand" class="text-secondary mb-1"></p>
                    <p class="text-muted mb-0">💰 Rate: LKR <span id="carRentalRate" class="fw-bold text-success"></span>/day</p>
                </div>
                <form id="bookingForm">
                    <input type="hidden" id="selectedCarId" />
                    <div class="mb-3">
                        <label for="pickupDate" class="form-label" style="color: #ffffff !important;">📅 Pickup Date</label>
                        <input type="date" class="form-control" id="pickupDate" required style="background: #3d3d3d !important; border: 1px solid #404040 !important; color: #ffffff !important;">
                    </div>
                    <div class="mb-3">
                        <label for="returnDate" class="form-label" style="color: #ffffff !important;">📅 Return Date</label>
                        <input type="date" class="form-control" id="returnDate" required style="background: #3d3d3d !important; border: 1px solid #404040 !important; color: #ffffff !important;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">💵 Total Booking Amount</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background: var(--tertiary-bg); border-color: var(--border-color); color: var(--text-primary);">LKR</span>
                            <input type="text" class="form-control" id="totalAmount" readonly style="background: var(--tertiary-bg); border-color: var(--border-color); color: var(--text-primary); font-weight: bold;">
                        </div>
                        <small class="form-text text-muted">Amount calculated automatically based on rental period</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="background: #2d2d2d !important; border-top: 1px solid #404040 !important;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="background: #3d3d3d !important; border: 1px solid #404040 !important; color: #ffffff !important;">Cancel</button>
                <button type="button" class="btn btn-primary" id="nextBtn" onclick="proceedToCustomerDetails()" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important; border: none !important; color: white !important;">Next →</button>
                <button type="button" class="btn btn-success" id="confirmBtn" onclick="confirmBooking()" style="display:none; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important; border: none !important; color: white !important;">✅ Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Customer Details Modal -->
<div  class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div  class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div style="background-color:navy" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerModalLabel">👤 Customer Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="customerForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="customerEmail" class="form-label">📧 Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="customerEmail" required placeholder="Enter your email address">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="customerName" class="form-label">👤 Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="customerName" required placeholder="Enter your full name" minlength="2">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="customerPhone" class="form-label">📱 Phone Number <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" id="customerPhone" required placeholder="Enter your phone number">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="customerNic" class="form-label">🆔 NIC Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="customerNic" >
                                <small class="form-text text-muted">Enter 9 digits + V/X or 12 digits</small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="customerAddress" class="form-label">🏠 Address <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="customerAddress" rows="3" required placeholder="Enter your complete address" minlength="10"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="drivingLicense" class="form-label">🚗 Driving License Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="drivingLicense" required placeholder="Enter your driving license number" minlength="5">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="dlIssueDate" class="form-label">📅 License Issue Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="dlIssueDate" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="dlExpiryDate" class="form-label">📅 License Expiry Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="dlExpiryDate" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="nicImage" class="form-label">🆔 NIC Image</label>
                                <input type="file" class="form-control" id="nicImage" accept="image/*" onchange="previewImage(this, 'nicPreview')">
                                <small class="form-text text-muted">Upload a clear photo of your NIC</small>
                                <div id="nicPreview" class="mt-2" style="display: none;">
                                    <img id="nicPreviewImg" src="" alt="NIC Preview" style="max-width: 100%; max-height: 150px; border-radius: 8px; border: 2px solid var(--border-color);">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="dlImage" class="form-label">🚗 Driving License Image</label>
                                <input type="file" class="form-control" id="dlImage" accept="image/*" onchange="previewImage(this, 'dlPreview')">
                                <small class="form-text text-muted">Upload a clear photo of your driving license</small>
                                <div id="dlPreview" class="mt-2" style="display: none;">
                                    <img id="dlPreviewImg" src="" alt="DL Preview" style="max-width: 100%; max-height: 150px; border-radius: 8px; border: 2px solid var(--border-color);">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">❌ Cancel</button>
                <button type="button" class="btn btn-success btn-lg" onclick="confirmBookingWithCustomer()">✅ Confirm Booking</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade success-modal" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="successModalLabel">🎉 Booking Confirmed!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="success-icon">✅</div>
                <h4 class="mb-3">Congratulations!</h4>
                <p class="mb-4">Your booking has been successfully completed!</p>
                <p class="small">Thank you for choosing our car rental service. You will receive a confirmation email shortly.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light btn-lg" data-bs-dismiss="modal">Awesome!</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Wait for DOM and Bootstrap to be ready
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, initializing booking functionality');
            console.log('Bootstrap available:', typeof bootstrap !== 'undefined');
            console.log('jQuery available:', typeof $ !== 'undefined');
            
            // Initialize event listeners after DOM is ready
            initializeBookingFunctionality();
        });

        function initializeBookingFunctionality() {
            // Calculate total amount when dates change
            const pickupDateInput = document.getElementById('pickupDate');
            const returnDateInput = document.getElementById('returnDate');
            
            if (pickupDateInput) {
                pickupDateInput.addEventListener('change', calculateTotalAmount);
            }
            if (returnDateInput) {
                returnDateInput.addEventListener('change', calculateTotalAmount);
            }
            
            // Initialize filter functionality
            initializeFilterFunctionality();
            
            // Initialize car filtering
            filterCars("", "");
        }

        const models = {
            "Honda": ["Civic", "Accord", "CR-V", "HR-V", "Pilot"],
            "Toyota": ["Corolla", "Camry", "Prius", "RAV4", "Hilux"],
            "Nissan": ["Altima", "Maxima", "Sentra", "Patrol", "GT-R"],
            "Subaru": ["Impreza", "Legacy", "Forester", "Outback", "WRX"],
            "BMW": ["3 Series", "5 Series", "7 Series", "X5", "M3"],
            "Mahindra": ["Scorpio", "XUV500", "XUV700", "Thar", "Bolero"]
        };

        // Initialize filter functionality if elements exist
        function initializeFilterFunctionality() {
            const brandFilter = document.getElementById("brandFilter");
            const modelFilter = document.getElementById("modelFilter");
            const searchBtn = document.getElementById("searchBtn");

            if (brandFilter && modelFilter && searchBtn) {
                brandFilter.addEventListener("change", function () {
                    const brand = this.value;
                    modelFilter.innerHTML = '<option value="">Select Model</option>';
                    modelFilter.disabled = true;
                    searchBtn.disabled = true;

                    if (brand && models[brand]) {
                        models[brand].forEach(model => {
                            let option = document.createElement("option");
                            option.value = model;
                            option.textContent = model;
                            modelFilter.appendChild(option);
                        });
                        modelFilter.disabled = false;
                    }
                    filterCars(brand, "");
                });

                modelFilter.addEventListener("change", function () {
                    searchBtn.disabled = !this.value;
                });

                searchBtn.addEventListener("click", function () {
                    const brand = brandFilter.value;
                    const model = modelFilter.value;
                    filterCars(brand, model);
                });
            }
        }

        function filterCars(brand, model) {
            const cars = document.querySelectorAll(".car-card");
            cars.forEach(car => {
                const carBrand = car.getAttribute("data-brand");
                const carModel = car.getAttribute("data-model");

                if ((!brand || carBrand === brand) && (!model || carModel === model)) {
                    car.style.display = "block";
                } else {
                    car.style.display = "none";
                }
            });
        }

        // Booking Modal Functions
        let currentBookingData = {};

        function openBookingModal(carId, carName, carBrand, rentalRate) {
            console.log('Opening booking modal for:', carName); // Debug log
            console.log('Modal element exists:', document.getElementById('bookingModal') !== null);
            
            currentBookingData = {
                carId: carId,
                carName: carName,
                carBrand: carBrand,
                rentalRate: rentalRate
            };

            const selectedCarId = document.getElementById('selectedCarId');
            const selectedCarName = document.getElementById('selectedCarName');
            const selectedCarBrand = document.getElementById('selectedCarBrand');
            const carRentalRate = document.getElementById('carRentalRate');

            if (selectedCarId) selectedCarId.value = carId;
            if (selectedCarName) selectedCarName.textContent = carName;
            if (selectedCarBrand) selectedCarBrand.textContent = carBrand;
            if (carRentalRate) carRentalRate.textContent = rentalRate;

            // Reset form
            const pickupDate = document.getElementById('pickupDate');
            const returnDate = document.getElementById('returnDate');
            const totalAmount = document.getElementById('totalAmount');

            if (pickupDate) pickupDate.value = '';
            if (returnDate) returnDate.value = '';
            if (totalAmount) totalAmount.value = '';

            // Set minimum date to today
            const today = new Date().toISOString().split('T')[0];
            if (pickupDate) pickupDate.min = today;
            if (returnDate) returnDate.min = today;

            // Reset button visibility
            const nextBtn = document.getElementById('nextBtn');
            const confirmBtn = document.getElementById('confirmBtn');
            if (nextBtn) nextBtn.style.display = 'inline-block';
            if (confirmBtn) confirmBtn.style.display = 'none';

            // Wait for Bootstrap to be available
            const modalElement = document.getElementById('bookingModal');
            if (modalElement) {
                if (typeof bootstrap !== 'undefined') {
                    console.log('Using Bootstrap modal');
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                } else if (typeof $ !== 'undefined') {
                    console.log('Using jQuery modal fallback');
                    $(modalElement).modal('show');
                } else {
                    console.error('Neither Bootstrap nor jQuery is available');
                    // Fallback: show modal manually
                    modalElement.style.display = 'block';
                    modalElement.classList.add('show');
                    document.body.classList.add('modal-open');
                }
            } else {
                console.error('Modal element not found');
            }
        }


        function calculateTotalAmount() {
            const pickupDate = document.getElementById('pickupDate').value;
            const returnDate = document.getElementById('returnDate').value;
            const rentalRate = currentBookingData.rentalRate;

            if (pickupDate && returnDate) {
                const pickup = new Date(pickupDate);
                const returnDateObj = new Date(returnDate);
                
                if (returnDateObj <= pickup) {
                    document.getElementById('totalAmount').value = 'Invalid dates';
                    return;
                }

                const days = Math.ceil((returnDateObj - pickup) / (1000 * 60 * 60 * 24));
                const totalAmount = days * rentalRate;
                document.getElementById('totalAmount').value = totalAmount.toFixed(2);
            }
        }

        function proceedToCustomerDetails() {
            const pickupDate = document.getElementById('pickupDate').value;
            const returnDate = document.getElementById('returnDate').value;
            const totalAmount = document.getElementById('totalAmount').value;

            // Validate dates are selected
            if (!pickupDate || !returnDate) {
                alert('Please select both pickup and return dates.');
                return;
            }

            // Validate return date is after pickup date
            if (new Date(returnDate) <= new Date(pickupDate)) {
                alert('Return date must be after pickup date.');
                return;
            }

            // Validate total amount is calculated
            if (!totalAmount || totalAmount === 'Invalid dates' || parseFloat(totalAmount) <= 0) {
                alert('Please ensure valid dates are selected and total amount is calculated.');
                return;
            }

            // Validate minimum rental period (at least 1 day)
            const pickup = new Date(pickupDate);
            const returnDateObj = new Date(returnDate);
            const days = Math.ceil((returnDateObj - pickup) / (1000 * 60 * 60 * 24));
            
            if (days < 1) {
                alert('Minimum rental period is 1 day.');
                return;
            }

            // Check if user exists
            checkExistingCustomer();
        }

        async function checkExistingCustomer() {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // For demonstration, let's check if there's a way to get current user email
                // You might need to modify this based on your authentication system
                let userEmail = '';
                
                // Try to get email from a hidden input or global variable if available
                const emailInput = document.getElementById('currentUserEmail');
                if (emailInput) {
                    userEmail = emailInput.value;
                }
                
                const response = await fetch('/Booking/CheckExistingCustomer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ email: userEmail })
                });

                const result = await response.json();
                
                if (result.exists && result.customerId) {
                    // Existing customer with complete data - show confirm button instead of next
                    document.getElementById('nextBtn').style.display = 'none';
                    document.getElementById('confirmBtn').style.display = 'inline-block';
                    currentBookingData.customerId = result.customerId;
                } else {
                    // New customer or incomplete data - show customer details modal
                    bootstrap.Modal.getInstance(document.getElementById('bookingModal')).hide();
                    
                    // Clear and pre-fill customer form
                    document.getElementById('customerForm').reset();
                    
                    // Pre-fill email if available
                    if (result.email) {
                        document.getElementById('customerEmail').value = result.email;
                    }
                    
                    const customerModal = new bootstrap.Modal(document.getElementById('customerModal'));
                    customerModal.show();
                }
            } catch (error) {
                console.error('Error checking customer:', error);
                // Default to new customer flow
                bootstrap.Modal.getInstance(document.getElementById('bookingModal')).hide();
                const customerModal = new bootstrap.Modal(document.getElementById('customerModal'));
                customerModal.show();
            }
        }

        async function confirmBooking() {
            const pickupDate = document.getElementById('pickupDate').value;
            const returnDate = document.getElementById('returnDate').value;
            const totalAmount = document.getElementById('totalAmount').value;

            // Validate dates and amount for existing customers too
            if (!pickupDate || !returnDate) {
                alert('Please select both pickup and return dates.');
                return;
            }

            if (new Date(returnDate) <= new Date(pickupDate)) {
                alert('Return date must be after pickup date.');
                return;
            }

            if (!totalAmount || totalAmount === 'Invalid dates' || parseFloat(totalAmount) <= 0) {
                alert('Please ensure valid dates are selected and total amount is calculated.');
                return;
            }

            const bookingData = {
                carId: currentBookingData.carId,
                customerId: currentBookingData.customerId,
                pickupDate: pickupDate,
                returnDate: returnDate,
                totalBookingAmount: totalAmount
            };

            try {
                // Show loading state
                const confirmBtn = event.target;
                const originalText = confirmBtn.innerHTML;
                confirmBtn.innerHTML = '<span class="loading"></span> Creating Booking...';
                confirmBtn.disabled = true;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Booking/CreateBookingFromPopup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(bookingData)
                });

                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('bookingModal')).hide();
                    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    successModal.show();
                } else {
                    alert('Error creating booking. Please try again.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error creating booking. Please try again.');
            } finally {
                // Reset button state
                const confirmBtn = event.target;
                confirmBtn.innerHTML = originalText;
                confirmBtn.disabled = false;
            }
        }

        async function confirmBookingWithCustomer() {
            // Validate all customer details
            const email = document.getElementById('customerEmail').value.trim();
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();
            const address = document.getElementById('customerAddress').value.trim();
            const nicNumber = document.getElementById('customerNic').value.trim();
            const drivingLicense = document.getElementById('drivingLicense').value.trim();
            const dlIssueDate = document.getElementById('dlIssueDate').value;
            const dlExpiryDate = document.getElementById('dlExpiryDate').value;

            // Email validation
            if (!email) {
                alert('Please enter your email address.');
                return;
            }
            if (email.length < 5) {
                alert('Please enter a valid email address.');
                return;
            }

            // Name validation
            if (!name) {
                alert('Please enter your full name.');
                return;
            }
            if (name.length < 2) {
                alert('Name must be at least 2 characters long.');
                return;
            }

            // Phone validation
            if (!phone) {
                alert('Please enter your phone number.');
                return;
            }
            const phoneRegex = /^[\+]?[0-9\s\-\(\)]{10,}$/;
            if (!phoneRegex.test(phone)) {
                alert('Please enter a valid phone number.');
                return;
            }

            // Address validation
            if (!address) {
                alert('Please enter your address.');
                return;
            }
            if (address.length < 10) {
                alert('Please enter a complete address (at least 10 characters).');
                return;
            }

            // NIC validation
            if (!nicNumber) {
                alert('Please enter your NIC number.');
                return;
            }
            // Basic NIC validation (assuming Sri Lankan format)
            const nicRegex = /^[0-9]{9}[vVxX]$|^[0-9]{12}$/;
            if (!nicRegex.test(nicNumber)) {
                alert('Please enter a valid NIC number (9 digits + V/X or 12 digits).');
                return;
            }

            // Driving License validation
            if (!drivingLicense) {
                alert('Please enter your driving license number.');
                return;
            }
            if (drivingLicense.length < 5) {
                alert('Please enter a valid driving license number.');
                return;
            }

            // License dates validation
            if (!dlIssueDate) {
                alert('Please enter your driving license issue date.');
                return;
            }
            if (!dlExpiryDate) {
                alert('Please enter your driving license expiry date.');
                return;
            }

            if (new Date(dlExpiryDate) <= new Date(dlIssueDate)) {
                alert('License expiry date must be after issue date.');
                return;
            }

            // Check if license is expired
            if (new Date(dlExpiryDate) < new Date()) {
                alert('Your driving license has expired. Please renew it before booking.');
                return;
            }

            // Create FormData to handle file uploads
            const formData = new FormData();
            
            // Add customer data
            formData.append('customerData[email]', document.getElementById('customerEmail').value);
            formData.append('customerData[name]', document.getElementById('customerName').value);
            formData.append('customerData[phoneNumber]', document.getElementById('customerPhone').value);
            formData.append('customerData[address]', document.getElementById('customerAddress').value);
            formData.append('customerData[nicNumber]', document.getElementById('customerNic').value);
            formData.append('customerData[drivingLicenceNumber]', document.getElementById('drivingLicense').value);
            formData.append('customerData[dlIssueDate]', document.getElementById('dlIssueDate').value);
            formData.append('customerData[dlExpiryDate]', document.getElementById('dlExpiryDate').value);
            
            // Add booking data
            formData.append('carId', currentBookingData.carId);
            formData.append('pickupDate', document.getElementById('pickupDate').value);
            formData.append('returnDate', document.getElementById('returnDate').value);
            formData.append('totalBookingAmount', document.getElementById('totalAmount').value);
            
            // Add image files if selected
            const nicImage = document.getElementById('nicImage').files[0];
            const dlImage = document.getElementById('dlImage').files[0];
            
            if (nicImage) {
                formData.append('nicImage', nicImage);
            }
            if (dlImage) {
                formData.append('dlImage', dlImage);
            }
            
            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

            try {
                // Show loading state
                const confirmBtn = event.target;
                const originalText = confirmBtn.innerHTML;
                confirmBtn.innerHTML = '<span class="loading"></span> Creating Booking...';
                confirmBtn.disabled = true;

                const response = await fetch('/Booking/CreateBookingWithNewCustomer', {
                    method: 'POST',
                    body: formData // Use FormData instead of JSON
                });

                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('customerModal')).hide();
                    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    successModal.show();
                } else {
                    const errorText = await response.text();
                    alert('Error creating booking: ' + errorText);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error creating booking. Please try again.');
            } finally {
                // Reset button state
                const confirmBtn = event.target;
                confirmBtn.innerHTML = originalText;
                confirmBtn.disabled = false;
            }
        }

        // Image preview function
        function previewImage(input, previewId) {
            const preview = document.getElementById(previewId);
            const previewImg = document.getElementById(previewId + 'Img');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.style.display = 'block';
                }
                
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
            }
        }

            async function saveBooking(bookingData) {
            const response = await fetch('/Booking/CreateBookingFromPopup', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(bookingData)
            });

            if (response.ok) {
                const result = await response.json();
                console.log("Booking saved:", result);
            } else {
                console.error("Error saving booking");
            }
        }
    </script>
}

