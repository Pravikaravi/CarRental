@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title CarGoRental</title>

    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="icon" type="image/x-icon" href="~/lib/favicon2.ico" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">


   


    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            min-height: 100vh;
        }

        /* ===== Navigation ===== */
        .Navigation {
            height: 90px;
            width: 100%;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #0B1225;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .car-rental-heading {
            font-size: 32px;
            font-family: 'Gill Sans', Calibri, sans-serif;
            color: #0fc0fc;
            margin: 0;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .nav a {
                color: white;
                text-decoration: none;
                font-size: 1em;
                padding: 10px 8px;
                border-radius: 2px;
                transition: color 0.3s ease, transform 0.3s ease;
            }

                .nav a:hover {
                    color: #0fc0fc;
                    transform: scale(1.05);
                    text-decoration: underline;
                    text-underline-offset: 6px;
                }

        /* ===== Profile Dropdown ===== */
        .profile {
            position: relative;
            display: inline-block;
        }

        .avatar-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            position: relative;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

            .avatar:hover {
                transform: scale(1.05);
            }

        .username {
            margin-top: 4px;
            font-size: 0.9rem;
            font-weight: bold;
            color: #0fc0fc;
        }

        .dropdown {
            display: none;
            position: absolute;
            top: 45px;
            right: 0;
            background-color: #0B1225;
            border-radius: 10px;
            box-shadow: 1px 6px 12px rgba(0,0,0,0.3);
            min-width: 150px;
            z-index: 1000;
        }

            .dropdown a {
                display: block;
                padding: 10px 15px;
                color: white;
                text-decoration: none;
                transition: background 0.3s ease;
            }

                .dropdown a:hover {
                    background-color: #0fc0fc;
                    color: #0B1225;
                }

        .profile:hover .dropdown {
            display: block;
        }

        /* ===== Search Box ===== */
        .search-container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 20px 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            width: 70%;
            margin: 40px auto;
        }

        .search-panel {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        select {
            padding: 12px 16px;
            border-radius: 12px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(0, 0, 0, 0.2);
            color: white;
            font-size: 1rem;
            appearance: none;
            cursor: pointer;
            transition: border-color 0.3s ease;
        }

            select:focus {
                outline: none;
                border-color: #0fc0fc;
                background: rgba(0, 0, 0, 0.4);
            }

        button {
            padding: 14px 0;
            border-radius: 12px;
            border: none;
            background: #0fc0fc;
            color: whitesmoke;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            button:disabled {
                background: #64748B;
                cursor: not-allowed;
            }

            button:not(:disabled):hover {
                background: #0fc0fc;
                transform: scale(1.05);
            }



        /* ===== Footer ===== */
        .footer {
            background: #0B1225;
            color: white;
            padding: 30px 20px 15px;
            margin-top: 40px;
            text-align: center;
            position: relative;
            bottom: 0;
            width: 100%;
        }

        .footer-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 20px;
            max-width: 1100px;
            margin: auto;
        }

        .footer-left h3 {
            color: #0fc0fc;
            margin-bottom: 10px;
        }

        .footer-left p {
            font-size: 0.9rem;
            color: #ccc;
        }

        .footer-center p {
            margin: 6px 0;
            font-size: 0.9rem;
        }

        .footer-center i {
            color: #0fc0fc;
            margin-right: 8px;
        }

        .footer-right a {
            margin: 0 8px;
            font-size: 1.2rem;
            color: #0fc0fc;
            transition: transform 0.3s;
        }

            .footer-right a:hover {
                transform: scale(1.2);
                color: #ffffff;
            }

        .footer-bottom {
            margin-top: 15px;
            border-top: 1px solid rgba(255,255,255,0.2);
            padding-top: 10px;
            font-size: 0.8rem;
            color: #888;
        }

    </style>
</head>

<body>
    <!-- Navbar -->
    <div class="Navigation">
        <div class="logo">
            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center text-decoration-none">
                <img src="~/Images/logo.png" alt="CAR GO Logo" style="height: 50px; object-fit: contain;">
                <h1 class="car-rental-heading ms-2">CarGo</h1>
            </a>
        </div>


        <div class="nav">
            <a href="@Url.Action("Index", "Home")?scroll=menu" id="menuLink">Menu</a>


            <a class="nav-link" asp-controller="Home" asp-action="Contactus">Contact Us</a>
            <a class="nav-link" asp-controller="Home" asp-action="Aboutus">About Us</a>
            @* <div class="notifications">
                <img src="~/Images/1157000.png" alt="Notifications Bell" style="height: 30px;">
            </div> *@

            <!-- Profile -->
            <div class="profile">
                @if (Context.Session.GetString("UserName") != null)
                {
                    var email = Context.Session.GetString("UserName");
                    var role = Context.Session.GetString("Role");
                    var username = email.Contains("@") ? email.Split('@')[0] : email;
                    var profilePic = Context.Session.GetString("ProfilePic");
                    @* var displayPic = !string.IsNullOrEmpty(profilePic) ? profilePic : "~/Images/User.png"; *@

                    string displayPic;
        if (role == "Staff")
        {
            displayPic = Url.Content("~/Images/Staff.png"); // hardcoded staff image
        }
        else if (role == "Customer")
        {
            displayPic = Url.Content("~/Images/User.png"); // hardcoded customer image
        }
        else
        {
            displayPic = Url.Content("~/Images/admin-default.png"); // admin default
        }


                    <div class="avatar-container">
    <img src="@displayPic" alt="Avatar" class="avatar" />
    <span class="username">@username</span>
    <div class="dropdown">
        @if (role == "Admin")
        {
            <a asp-controller="Admin" asp-action="AdminDashboard">Admin Dashboard</a>
        }
        else if (role == "Staff")
        {
            <a asp-controller="Staff" asp-action="StaffDashboard">Staff Dashboard</a>
        }
        else
        {
            <a asp-controller="Customer" asp-action="CustomerDashboard">User Dashboard</a>
        }
        <a asp-controller="Account" asp-action="Logout">Logout</a>
    </div>
</div>

                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
    </div>


    <!-- Page content -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- ===== Footer ===== -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-left">
                <h3>CarGo</h3>
                <p>Drive your dream car today with comfort and safety.</p>
            </div>

            <div class="footer-center">
                <p><i class="fas fa-phone"></i> +94 77 123 4567</p>
                <p><i class="fas fa-envelope"></i> cargorental2@gmail.com</p>
                <p><i class="fas fa-map-marker-alt"></i> Jaffna, Sri Lanka</p>
            </div>

            <div class="footer-right">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
            </div>
        </div>

        <!-- New Footer Links Section -->
        <div class="footer-links">
            <a href="@Url.Action("Terms", "Home")">Terms & Conditions</a> |
            <a href="@Url.Action("FAQ", "Home")">FAQ</a> |
            <a href="@Url.Action("Developers", "Home")">Developer Team</a>
        </div>


        <div class="footer-bottom">
            <p>© @DateTime.Now.Year CarGo. All Rights Reserved.</p>
        </div>
    </footer>


    @RenderSection("Scripts", required: false)

    <!-- Your smooth scroll script -->
    <script>
        // When the DOM is loaded
        document.addEventListener("DOMContentLoaded", function () {
            // Check if URL has ?scroll=menu
            const params = new URLSearchParams(window.location.search);
            if (params.get("scroll") === "menu") {
                const menuSection = document.getElementById("carMenu");
                if (menuSection) {
                    menuSection.scrollIntoView({ behavior: "smooth" });
                }
            }
        });
    </script>


    <!-- jQuery (required for Bootstrap) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
