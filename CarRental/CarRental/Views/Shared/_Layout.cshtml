    <script>
        const models = {
            "Honda": ["Civic", "Accord", "CR-V", "HR-V", "Pilot"],
            "Toyota": ["Corolla", "Camry", "Prius", "RAV4", "Hilux"],
            "Nissan": ["Altima", "Maxima", "Sentra", "Patrol", "GT-R"],
            "Subaru": ["Impreza", "Legacy", "Forester", "Outback", "WRX"],
            "BMW": ["3 Series", "5 Series", "7 Series", "X5", "M3"],
            "Mahindra": ["Scorpio", "XUV500", "XUV700", "Thar", "Bolero"]
        };

        const brandFilter = document.getElementById("brandFilter");
        const modelFilter = document.getElementById("modelFilter");
        const searchBtn = document.getElementById("searchBtn");
        const resetBtn = document.getElementById("resetBtn");
        const carContainer = document.getElementById("carContainer");

        brandFilter.addEventListener("change", function () {
            const brand = this.value;
            modelFilter.innerHTML = '<option value="">Select Model</option>';
            modelFilter.disabled = true;
            searchBtn.disabled = true;

            if (brand && models[brand]) {
                models[brand].forEach(model => {
                    let option = document.createElement("option");
                    option.value = model;
                    option.textContent = model;
                    modelFilter.appendChild(option);
                });
                modelFilter.disabled = false;
            }
            filterCars(brand, "");
        });

        modelFilter.addEventListener("change", function () {
            searchBtn.disabled = !this.value;
        });

        searchBtn.addEventListener("click", function () {
            const brand = brandFilter.value;
            const model = modelFilter.value;
            filterCars(brand, model);
        });

        resetBtn.addEventListener("click", function () {
            brandFilter.value = "";
            modelFilter.innerHTML = '<option value="">Select Model</option>';
            modelFilter.disabled = true;
            searchBtn.disabled = true;
            filterCars("", "");
        });

        function filterCars(brand, model) {
            const cars = document.querySelectorAll(".car-card");
            cars.forEach(car => {
                const carBrand = car.getAttribute("data-brand");
                const carModel = car.getAttribute("data-model");

                if ((!brand || carBrand === brand) && (!model || carModel === model)) {
                    car.style.display = "block";
                } else {
                    car.style.display = "none";
                }
            });
        }

        // Show all cars on page load
        filterCars("", "");
    </script>

    <div class="content">
        @RenderBody()
    </div>
</body>
