            background-color: #0fc0fc;
            color: #0B1225;
            border: none;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .book-btn:hover {
                background-color: #0fc0fc;
                transform: scale(1.05);
                box-shadow: 0 0 10px #0fc0fc, 0 0 20px #0fc0fc;
