@model IEnumerable<CarRental.Models.Booking>
@{
    ViewData["Title"] = "Bookings";
}
<h2>Bookings</h2>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Car Id</th>
            <th>Customer Id</th>
            <th>Pickup</th>
            <th>Return</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.CarId</td>
                <td>@booking.CustomerId</td>
                <td>@booking.PickupDate.ToShortDateString()</td>
                <td>@booking.ReturnDate.ToShortDateString()</td>
                <td>@booking.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@booking.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-primary">New Booking</a>
