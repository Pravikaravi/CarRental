@model CarRental.Models.Booking
@{
    ViewData["Title"] = "Delete Booking";
}
<h2>Delete Booking</h2>

<div>
    <h4>Are you sure you want to delete this booking?</h4>
    <p><strong>Car Id:</strong> @Model.CarId</p>
    <p><strong>Customer Id:</strong> @Model.CustomerId</p>
    <p><strong>Pickup:</strong> @Model.PickupDate.ToShortDateString()</p>
    <p><strong>Return:</strong> @Model.ReturnDate.ToShortDateString()</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
