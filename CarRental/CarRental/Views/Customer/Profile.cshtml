@model CarRental.Models.Customer

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<style>
    .profile-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
        min-height: calc(100vh - 90px);
        background-color: #0B1225;
    }

    .profile-box {
        width: 750px;
        background-color: #1E293B;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 0 18px #0fc0fc;
        color: #fff;
    }

        .profile-box h2 {
            color: #0fc0fc;
            text-align: center;
            margin-bottom: 25px;
            font-size: 24px;
            font-weight: bold;
        }

    .form-label {
        color: #0fc0fc;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .form-control {
        background-color: #334155 !important;
        color: #fff !important;
        border: 1px solid #0fc0fc !important;
        border-radius: 8px !important;
        padding: 12px !important;
        font-size: 14px !important;
        height: 45px !important;
        margin-bottom: 12px;
    }

        .form-control:focus {
            box-shadow: 0 0 5px #0fc0fc;
            border-color: #0fc0fc;
        }

    input[readonly] {
        background-color: #2c3e50 !important;
        cursor: not-allowed;
    }

    .img-preview {
        margin-top: 8px;
        max-width: 100%;
        height: 120px;
        border-radius: 8px;
        border: 2px solid #0fc0fc;
        object-fit: cover;
    }

    .btn {
        padding: 10px 22px !important;
        border-radius: 10px !important;
        font-weight: bold !important;
        font-size: 15px !important;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-primary {
        background-color: #0fc0fc !important;
        color: #0B1225 !important;
        box-shadow: 0 0 12px #0fc0fc;
    }

        .btn-primary:hover {
            transform: scale(1.04);
            box-shadow: 0 0 20px #0fc0fc;
        }

    .alert {
        border-radius: 8px;
        margin-bottom: 15px;
        font-size: 14px;
    }
</style>

<div class="profile-wrapper">
    <div class="profile-box">
        <h2><i class="fa fa-user-edit"></i> Customer Profile</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <form asp-action="Profile" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="row g-3">
                <!-- Editable fields -->
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" required />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" pattern="^[0-9]{10}$" title="Enter valid 10-digit phone number" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Readonly fields -->
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="NicNumber" class="form-label"></label>
                    <input asp-for="NicNumber" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">NIC Image</label>
                    @if (!string.IsNullOrEmpty(Model.NicImageUrl))
                    {
                        <img src="@Url.Content(Model.NicImageUrl)" alt="NIC Image" class="img-preview" />
                    }
                </div>

                <div class="col-md-6">
                    <label asp-for="DrivingLicenceNumber" class="form-label"></label>
                    <input asp-for="DrivingLicenceNumber" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Driving License Image</label>
                    @if (!string.IsNullOrEmpty(Model.DLImageUrl))
                    {
                        <img src="@Url.Content(Model.DLImageUrl)" alt="DL Image" class="img-preview" />
                    }
                </div>

                <div class="col-md-6">
                    <label asp-for="DLIssueDate" class="form-label"></label>
                    <input asp-for="DLIssueDate" type="date" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="DLExpiryDate" class="form-label"></label>
                    <input asp-for="DLExpiryDate" type="date" class="form-control" readonly />
                </div>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Save Change
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Auto-hide TempData messages after 3 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                alert.style.transition = "opacity 0.5s ease, transform 0.5s ease";
                alert.style.opacity = "0";
                alert.style.transform = "translateY(-10px)";
                setTimeout(() => alert.remove(), 500); // remove after fade/slide
            });
        }, 3000);
    </script>
}
