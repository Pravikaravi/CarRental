@model IEnumerable<CarRental.Models.Feedback>

@{
    ViewData["Title"] = "My Feedbacks";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; // your user layout
}

<style>
.text-truncate {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.btn-custom {
    border-radius: 50px;
    padding: 6px 12px;
    transition: all 0.3s ease;
}

.btn-view {
    background-color: #17a2b8;
    color: white;
    border: none;
}

.btn-view:hover {
    background-color: #138496;
}
</style>

<main>
    <div class="container mt-4">
        <h2 class="text-center text-info mb-4">
            <i class="bi bi-chat-left-text"></i> My Feedbacks
        </h2>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive shadow rounded">
                <table class="table table-dark table-hover align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Subject</th>
                            <th>Feedback</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Select((feedback, index) => new { feedback, index }))
                        {
                            <tr>
                                <td>@(item.index + 1)</td>
                                <td>@item.feedback.Title</td>
                                <td class="text-truncate">@item.feedback.UserFeedback</td>
                                <td>
                                    <button type="button" 
                                            class="btn btn-sm btn-view btn-custom"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewModal-@item.feedback.Id">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Modals -->
            @foreach (var item in Model)
            {
                <div class="modal fade" id="viewModal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header">
                                <h5 class="modal-title text-info">
                                    <i class="bi bi-chat-quote"></i> Feedback
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p><strong>Subject:</strong> @item.Title</p>
                                <hr />
                                <p>@item.UserFeedback</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle"></i> You have not submitted any feedback yet.
            </div>
        }
    </div>
</main>
