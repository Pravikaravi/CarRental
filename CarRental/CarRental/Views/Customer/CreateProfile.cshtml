@model CarRental.Models.Customer
@{
    ViewBag.Title = "Create Profile";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2 style="color:#0fc0fc;"><i class="fa fa-user-plus"></i> Create Customer Profile</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<form asp-action="CreateProfile" method="post" enctype="multipart/form-data" style="margin-top: 30px;">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label asp-for="Name" style="color:#0fc0fc;"></label>
        <input asp-for="Name" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label asp-for="Email" style="color:#0fc0fc;"></label>
        <input asp-for="Email" class="form-control" readonly style="background-color:#334155; color:#0fc0fc;" />
    </div>

    <div class="form-group">
        <label asp-for="Address" style="color:#0fc0fc;"></label>
        <input asp-for="Address" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber" style="color:#0fc0fc;"></label>
        <input asp-for="PhoneNumber" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label asp-for="NicNumber" style="color:#0fc0fc;"></label>
        <input asp-for="NicNumber" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label style="color:#0fc0fc;">NIC Image</label>
        <input type="file" name="NicImage" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label asp-for="DrivingLicenceNumber" style="color:#0fc0fc;"></label>
        <input asp-for="DrivingLicenceNumber" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label style="color:#0fc0fc;">Driving License Image</label>
        <input type="file" name="DLImage" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label asp-for="DLIssueDate" style="color:#0fc0fc;"></label>
        <input asp-for="DLIssueDate" type="date" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <div class="form-group">
        <label asp-for="DLExpiryDate" style="color:#0fc0fc;"></label>
        <input asp-for="DLExpiryDate" type="date" class="form-control" required style="background-color:#1E293B; color:#fff;" />
    </div>

    <button type="submit" class="btn" style="background-color:#0fc0fc; color:#0B1225; font-weight:bold; box-shadow:0 0 10px #0fc0fc; transition:0.3s;">
        <i class="fa fa-save"></i> Save Profile
    </button>
</form>
