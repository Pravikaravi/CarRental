@model IEnumerable<CarRental.Models.Feedback>

@{
    ViewData["Title"] = "User Feedbacks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
/* Full height layout */
html, body {
    height: 100%;
    margin: 0;
}

body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

main {
    flex: 1;
}

/* Table Styles */
.table-container {
    margin-top: 20px;
}

.table thead {
    background-color: #17a2b8 !important;
    color: #000;
}

.table tbody tr:hover {
    background-color: rgba(23, 162, 184, 0.2);
}

.text-truncate {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Buttons */
.btn-custom {
    border-radius: 50px;
    padding: 6px 12px;
    transition: all 0.3s ease;
}

.btn-custom:hover {
    transform: translateY(-2px);
}

/* View button - info */
.btn-view {
    background-color: #17a2b8;
    color: white;
    border: none;
}

.btn-view:hover {
    background-color: #138496;
}

/* Delete button - danger */
.btn-delete {
    background-color: #dc3545;
    color: white;
    border: none;
}

.btn-delete:hover {
    background-color: #bd2130;
}
</style>

<main>
    <div class="container table-container">
        <h2 class="text-center text-info mb-4">
            <i class="bi bi-chat-left-text"></i> User Feedbacks
        </h2>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive shadow rounded">
                <table class="table table-dark table-hover align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Subject</th>
                            <th>Feedback</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Select((feedback, index) => new { feedback, index }))
                        {
                            <tr>
                                <td>@(item.index + 1)</td>
                                <td>@item.feedback.UserId</td>
                                <td>@item.feedback.Name</td>
                                <td>@item.feedback.Title</td>
                                <td class="text-truncate">@item.feedback.UserFeedback</td>
                                <td>
                                    <!-- View Button -->
                                    <button type="button" 
                                            class="btn btn-sm btn-view btn-custom"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewModal-@item.feedback.Id">
                                        <i class="bi bi-eye"></i> View
                                    </button>

                                    <!-- Delete Button -->
                                    <form asp-action="DeleteFeedback"
                                          asp-route-id="@item.feedback.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this feedback?');">
                                        <button type="submit" class="btn btn-sm btn-delete btn-custom">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Modals outside table -->
            @foreach (var item in Model)
            {
                <div class="modal fade" id="viewModal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header">
                                <h5 class="modal-title text-info">
                                    <i class="bi bi-chat-quote"></i> Feedback from @item.Name
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p><strong>Subject:</strong> @item.Title</p>
                                <hr />
                                <p>@item.UserFeedback</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle"></i> No feedbacks available yet.
            </div>
        }
    </div>
</main>
