@{
    ViewBag.Title = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - CarGo</title>

    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Navbar */
        .Navigation {
            height: 90px;
            width: 100%;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #0B1225;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .car-rental-heading {
            font-size: 28px;
            font-family: 'Gill Sans', Calibri, sans-serif;
            color: #0fc0fc;
            margin: 0;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .nav a {
                color: white;
                text-decoration: none;
                font-size: 1em;
                padding: 10px 8px;
                border-radius: 2px;
                transition: color 0.3s ease, transform 0.3s ease;
            }

                .nav a:hover {
                    color: #0fc0fc;
                    transform: scale(1.05);
                    text-decoration: underline;
                    text-decoration-thickness: 2px;
                    text-underline-offset: 6px;
                }

        /* Dashboard Container */
        .dashboard-container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 20px;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background-color: #1E293B;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0,0,0,0.4);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
            }

            .card h3 {
                font-size: 18px;
                margin: 0 0 10px 0;
                color: #9ca3af;
            }

            .card .value {
                font-size: 28px;
                font-weight: bold;
                color: #ffffff;
            }

            .card .icon {
                font-size: 1.5rem;
                margin-top: 10px;
                color: #0fc0fc;
            }

        /* Charts Section */
        .charts-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }

        .chart-card {
            background-color: #1E293B;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0,0,0,0.4);
        }

            .chart-card h3 {
                margin-bottom: 15px;
                color: #0fc0fc;
            }
    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="Navigation">
        <div class="logo">
            <img src="~/Images/logo.png" alt="CarGo Logo" style="height: 50px; object-fit: contain;">
            <h1 class="car-rental-heading">Admin Dashboard</h1>
        </div>
        <div class="nav">
            <a href="@Url.Action("AdminDashboard", "Admin")">Dashboard</a>
            <a href="@Url.Action("BookingManagement", "Admin")">Bookings</a>
            <a href="@Url.Action("CarManagement", "Admin")">Cars</a>
            <a href="@Url.Action("StaffManagement", "Admin")">Staff</a>
            <a href="@Url.Action("AdminNotifications", "Admin")">Notifications</a>
            <a href="@Url.Action("AdminProfile", "Admin")">Profile</a>
        </div>
    </div>

    <!-- Dashboard Content -->
    <div class="dashboard-container">

        <!-- Stats -->
        <div class="stats-grid">
            <div class="card">
                <h3>Total Bookings</h3>
                <div class="value">1,247</div>
                <div class="icon"><i class="fa fa-calendar-check"></i></div>
            </div>
            <div class="card">
                <h3>Total Revenue</h3>
                <div class="value">$89,420</div>
                <div class="icon"><i class="fa fa-dollar-sign"></i></div>
            </div>
            <div class="card">
                <h3>Total Cars</h3>
                <div class="value">342</div>
                <div class="icon"><i class="fa fa-car"></i></div>
            </div>
            <div class="card">
                <h3>Pending Reservations</h3>
                <div class="value">23</div>
                <div class="icon"><i class="fa fa-clock"></i></div>
            </div>
        </div>

        <!-- Charts -->
        <div class="charts-grid">
            <div class="chart-card">
                <h3>Booking Trends</h3>
                <canvas id="bookingTrendsChart"></canvas>
            </div>
            <div class="chart-card">
                <h3>Popular Vehicle Categories</h3>
                <canvas id="vehicleCategoriesChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        // Booking Trends Chart
        new Chart(document.getElementById("bookingTrendsChart"), {
            type: "line",
            data: {
                labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
                datasets: [{
                    label: "Bookings",
                    data: [12, 19, 15, 25, 20, 30, 27],
                    borderColor: "#0fc0fc",
                    backgroundColor: "rgba(15,192,252,0.2)",
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });

        // Vehicle Categories Chart
        new Chart(document.getElementById("vehicleCategoriesChart"), {
            type: "doughnut",
            data: {
                labels: ["Sedan", "SUV", "Compact", "Luxury", "Electric"],
                datasets: [{
                    data: [25, 35, 20, 10, 10],
                    backgroundColor: ["#3b82f6", "#f59e0b", "#10b981", "#ef4444", "#9ca3af"]
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: "bottom", labels: { color: "#ffffff" } } }
            }
        });
    </script>
</body>
</html>
