@{
    ViewBag.Title = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - CarGo</title>

    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        /* Navbar */
        .Navigation {
            height: 90px;
            width: 100%;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #0B1225;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .car-rental-heading {
            font-size: 28px;
            font-family: 'Gill Sans', Calibri, sans-serif;
            color: #0fc0fc;
            margin: 0;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .nav a {
                color: white;
                text-decoration: none;
                font-size: 1em;
                padding: 10px 8px;
                border-radius: 2px;
                transition: color 0.3s ease, transform 0.3s ease;
            }

                .nav a:hover {
                    color: #0fc0fc;
                    transform: scale(1.05);
                    text-decoration: underline;
                    text-decoration-thickness: 2px;
                    text-underline-offset: 6px;
                }


        /* Back button */
        .back-btn {
            color: #0fc0fc;
            font-size: 1.5rem;
            text-decoration: none;
            margin-right: 15px;
            transition: transform 0.3s ease, color 0.3s ease;
        }

            .back-btn:hover {
                color: #ffffff;
                transform: scale(1.2);
            }

    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="Navigation">
        <div class="logo">
            <!-- Back button with FontAwesome arrow -->
            <a href="javascript:history.back()" class="back-btn">
                <i class="fa fa-arrow-left"></i>
            </a>
            <img src="~/Images/logo.png" alt="CarGo Logo" style="height: 50px; object-fit: contain;">
            <h1 class="car-rental-heading">Welcome Admin</h1>
        </div>
        <div class="nav">
            <a href="@Url.Action("AdminDashboard", "Admin")">Dashboard</a>
            <a href="@Url.Action("AdminProfile", "Admin")">Profile</a>
            <a href="@Url.Action("AdminNotifications", "Admin")">Notifications</a>
            <a href="@Url.Action("StaffManagement", "Admin")">Staff</a>
            <a href="@Url.Action("BookingManagement", "Admin")">Bookings</a>
            <a href="@Url.Action("Index", "Car")">Cars</a>
            <a href="@Url.Action("NewBooking", "Admin")">New Booking</a>
        </div>
    </div>

    <!-- Page Content -->
    <div style="padding:40px; text-align:center;">
        <h2>Admin Dashboard</h2>
        <p>Select an option from the navigation bar.</p>
    </div>

    
</body>
</html>
