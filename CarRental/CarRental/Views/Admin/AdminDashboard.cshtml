@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="margin-top:30px; display:flex; justify-content:center; align-items:center; gap:40px; flex-wrap:wrap;">

    <div style="background-color:#0fc0fc; color:#0B1225; padding:20px 40px; border-radius:10px; box-shadow:0 0 15px #0fc0fc; min-width:220px;">
        <h3 style="margin:0; font-size:24px;">Total Cars</h3>
        <p style="font-size:36px; font-weight:bold; margin:10px 0;">@ViewBag.TotalCars</p>
    </div>

    <div style="background-color:#0fc0fc; color:#0B1225; padding:20px 40px; border-radius:10px; box-shadow:0 0 15px #0fc0fc; min-width:220px;">
        <h3 style="margin:0; font-size:24px;">Total Customers</h3>
        <p style="font-size:36px; font-weight:bold; margin:10px 0;">@ViewBag.TotalCustomers</p>
    </div>

    <div style="background-color:#0fc0fc; color:#0B1225; padding:20px 40px; border-radius:10px; box-shadow:0 0 15px #0fc0fc; min-width:220px;">
        <h3 style="margin:0; font-size:24px;">Total Staffs</h3>
        <p style="font-size:36px; font-weight:bold; margin:10px 0;">@ViewBag.TotalStaffs</p>
    </div>
</div>
