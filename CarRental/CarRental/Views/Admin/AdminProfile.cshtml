@{
    ViewBag.Title = "Admin Profile";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - CarGo</title>

    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        /* Navbar */
        .Navigation {
            height: 90px;
            width: 100%;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #0B1225;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .car-rental-heading {
            font-size: 28px;
            font-family: 'Gill Sans', Calibri, sans-serif;
            color: #0fc0fc;
            margin: 0;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .nav a {
                color: white;
                text-decoration: none;
                font-size: 1em;
                padding: 10px 8px;
                border-radius: 2px;
                transition: color 0.3s ease, transform 0.3s ease;
            }

                .nav a:hover {
                    color: #0fc0fc;
                    transform: scale(1.05);
                    text-decoration: underline;
                    text-decoration-thickness: 2px;
                    text-underline-offset: 6px;
                }

        .back-btn {
            color: #0fc0fc;
            font-size: 1.5rem;
            text-decoration: none;
            margin-right: 15px;
            transition: transform 0.3s ease, color 0.3s ease;
        }

            .back-btn:hover {
                color: #ffffff;
                transform: scale(1.2);
            }

        /* Profile Section */
        .profile-container {
            max-width: 800px;
            margin: 50px auto;
            background-color: #1E293B;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

            .profile-header img {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid #0fc0fc;
            }

            .profile-header h2 {
                margin: 0;
                color: #0fc0fc;
            }

        .profile-details {
            display: grid;
            grid-template-columns: 1fr 2fr;
            row-gap: 15px;
            column-gap: 20px;
            color: #ffffff;
        }

            .profile-details label {
                font-weight: bold;
                color: #a0aec0;
            }

            .profile-details input {
                padding: 8px 10px;
                border-radius: 5px;
                border: none;
                outline: none;
                width: 100%;
                background-color: #334155;
                color: #ffffff;
            }

                .profile-details input:disabled {
                    background-color: #1e293b;
                    color: #a0aec0;
                }

        .btn-save {
            margin-top: 20px;
            padding: 10px 20px;
            background-color: #0fc0fc;
            border: none;
            border-radius: 5px;
            color: #0B1225;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s ease, background-color 0.3s ease;
        }

            .btn-save:hover {
                background-color: #09a0d8;
                transform: scale(1.05);
            }

    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="Navigation">
        <div class="logo">
            <a href="javascript:history.back()" class="back-btn">
                <i class="fa fa-arrow-left"></i>
            </a>
            <img src="~/Images/logo.png" alt="CarGo Logo" style="height: 50px; object-fit: contain;">
            <h1 class="car-rental-heading">Admin Profile</h1>
        </div>
        @* <div class="nav">
            <a href="@Url.Action("AdminDashboard", "Admin")">Dashboard</a>
            <a href="@Url.Action("AdminProfile", "Admin")">Profile</a>
            <a href="@Url.Action("AdminNotifications", "Admin")">Notifications</a>
            <a href="@Url.Action("StaffManagement", "Admin")">Staff</a>
            <a href="@Url.Action("BookingManagement", "Admin")">Bookings</a>
            <a href="@Url.Action("CarManagement", "Admin")">Cars</a>
            <a href="@Url.Action("NewBooking", "Admin")">New Booking</a>
        </div> *@
    </div>

    <!-- Profile Content -->
    <div class="profile-container">
        <div class="profile-header">
            <img src="~/Images/admin-avatar.png" alt="Admin Avatar">
            <h2>Admin Name</h2>
        </div>
        <form>
            <div class="profile-details">
                <label>Full Name</label>
                <input type="text" value="Admin Name" />

                <label>Email</label>
                <input type="email" value="admin@example.com" />

                <label>Phone</label>
                <input type="text" value="+123 456 7890" />

                <label>Role</label>
                <input type="text" value="Administrator" disabled />

                <label>Joined Date</label>
                <input type="text" value="01-Jan-2023" disabled />
            </div>
            <button type="submit" class="btn-save">Save Changes</button>
        </form>
    </div>

</body>
</html>
