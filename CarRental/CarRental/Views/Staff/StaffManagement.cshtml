@model IEnumerable<CarRental.Models.Staff>
@{
    ViewData["Title"] = "Staff Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #0B1225, #1E293B);
            font-family: 'Segoe UI', sans-serif;
            color: #fff;
            padding: 40px;
        }

        h2 {
            color: #0fc0fc;
            text-align: center;
            margin-bottom: 30px;
        }

        .alert-success {
            background-color: #0fc0fc;
            color: #0B1225;
            padding: 10px;
            border-radius: 6px;
            text-align: center;
            box-shadow: 0 0 10px #0fc0fc;
            margin-bottom: 20px;
        }

        .btn {
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
            margin-right: 6px;
            text-decoration: none;
            display: inline-block;
        }

        .btn-edit {
            background-color: #facc15;
            color: #0B1225;
        }

        .btn-delete {
            background-color: #ef4444;
            color: #fff;
        }

        .btn-details {
            background-color: #0fc0fc;
            color: #0B1225;
        }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 8px #0fc0fc;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #1E293B;
            box-shadow: 0 0 15px rgba(15, 192, 252, 0.2);
            border-radius: 12px;
            overflow: hidden;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #334155;
            text-align: left;
        }

        th {
            background-color: #0fc0fc;
            color: #0B1225;
        }

        tr:hover {
            background-color: #334155;
        }
    </style>
</head>
<body>
    <h2><i class="fa fa-users"></i> Staff Management</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">@TempData["SuccessMessage"]</div>
    }

    <div style="margin-bottom: 20px; text-align: center;">
        <a href="@Url.Action("CreateStaff", "Staff")" class="btn btn-details">➕ Add Staff</a>
        <a href="@Url.Action("List", "Staff")" class="btn btn-details ">📋 Staff List</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var staff in Model)
                {
                    <tr>
                        <td>@(staff?.Name ?? "N/A")</td>
                        <td>@(staff?.EmailId ?? "N/A")</td>
                        <td>@(staff?.PhoneNumber ?? "N/A")</td>
                        <td>@(staff?.IsActive == true ? "Active" : "Inactive")</td>
                        <td>
                            @if (staff?.Id != Guid.Empty)
                            {
                                <a asp-action="Edit" asp-route-id="@staff.Id" class="btn btn-edit"><i class="fa fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@staff.Id" class="btn btn-details"><i class="fa fa-eye"></i></a>
                                <form asp-action="Delete" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@staff.Id" />
                                    <button type="submit" class="btn btn-delete"><i class="fa fa-trash"></i></button>
                                </form>
                            }
                            else
                            {
                                <span style="color:#ff4c4c;">Invalid ID</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align:center;">No staff records found.</td>
                </tr>
            }
        </tbody>
        </tbody>
    </table>
</body>
</html>
