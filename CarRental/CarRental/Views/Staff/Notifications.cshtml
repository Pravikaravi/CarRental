@model IEnumerable<CarRental.Models.Feedback>
@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark text-white">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Customer Notifications</h2>
            <a class="btn btn-outline-info" href="@Url.Action("StaffDashboard", "Staff")">Back to Dashboard</a>
        </div>

        @if (TempData["AssistSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["AssistSuccess"]</div>
        }
        @if (TempData["AssistError"] != null)
        {
            <div class="alert alert-danger">@TempData["AssistError"]</div>
        }

        <div class="list-group">
            @foreach (var f in Model)
            {
                <div class="list-group-item list-group-item-action bg-secondary text-white mb-2">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@f.Title</h5>
                    </div>
                    <p class="mb-1">@f.UserFeedback</p>
                    <small>From: @f.Name</small>

                </div>
            }
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>