@{
    ViewData["Title"] = "Create Staff";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CarGo</title>
    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0B1225 0%, #1E293B 50%, #334155 100%);
            color: #ffffff;
            margin: 0;
            padding: 40px;
        }

        .form-container {
            max-width: 600px;
            margin: auto;
            background-color: #1E293B;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 0 15px #0fc0fc;
        }

        h2 {
            color: #0fc0fc;
            text-align: center;
            margin-bottom: 30px;
        }

        label {
            color: #0fc0fc;
            font-weight: bold;
            margin-bottom: 6px;
            display: block;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        textarea {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 6px;
            background-color: #334155;
            color: white;
            box-shadow: inset 0 0 5px #0fc0fc;
            margin-bottom: 20px;
        }

        input[type="password"] {
            autocomplete: off;
        }

        .btn-submit {
            background-color: #0fc0fc;
            color: #0B1225;
            font-weight: bold;
            padding: 12px;
            border: none;
            border-radius: 6px;
            width: 100%;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .btn-submit:hover {
                transform: scale(1.05);
                box-shadow: 0 0 10px #0fc0fc;
            }

        .alert {
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            text-align: center;
        }

        .alert-danger {
            background-color: #ff4c4c;
            color: #0B1225;
            box-shadow: 0 0 10px #ff4c4c;
        }

        .alert-success {
            background-color: #0fc0fc;
            color: #0B1225;
            box-shadow: 0 0 10px #0fc0fc;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <h2><i class="fa fa-user-plus"></i> Add New Staff</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-controller="Staff" asp-action="CreateStaff" method="post" id="staffForm">
            <label>Full Name</label>
            <input type="text" name="name" required minlength="3" maxlength="50"
                   pattern="^[A-Za-z\s]+$" title="Name should only contain letters and spaces (3-50 characters)" />

            <label>Email (Login ID)</label>
            <input type="email" name="email" required
                   title="Please enter a valid email address" />

            <label>Password</label>
            <input type="password" name="password" required minlength="6" maxlength="20"
                   title="Password must be 6-20 characters long" autocomplete="off" />

            <label>Phone Number</label>
            <input type="text" name="phoneNumber" required
                   pattern="^\d{10}$" maxlength="10"
                   title="Phone number must be exactly 10 digits" />

            <label>Address</label>
            <textarea name="address" rows="3" required minlength="5" maxlength="100"
                      title="Address must be between 5 and 100 characters"></textarea>

            <button type="submit" class="btn-submit">Create Staff</button>
        </form>

        <script>
            $(document).ready(function () {
                $("#staffForm").on("submit", function (e) {
                    let phone = $("input[name='phoneNumber']").val();
                    if (!/^\d{10}$/.test(phone)) {
                        alert("Phone number must be exactly 10 digits.");
                        e.preventDefault();
                    }
                });
            });
        </script>

    </div>
</body>
</html>
