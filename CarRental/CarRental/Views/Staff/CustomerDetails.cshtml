@model CarRental.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark text-white">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Customer - @Model?.Name</h2>
            <div>
                <a class="btn btn-outline-info" href="@Url.Action("Customers", "Staff")">Back</a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="card bg-secondary text-white">
                    <div class="card-body">
                        <h5 class="card-title">Contact</h5>
                        <p class="mb-1"><strong>Email:</strong> @Model?.Email</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model?.PhoneNumber</p>
                        <p class="mb-0"><strong>Address:</strong> @Model?.Address</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-secondary text-white">
                    <div class="card-body">
                        <h5 class="card-title">Identity</h5>
                        <p class="mb-1"><strong>NIC:</strong> @Model?.NicNumber</p>
                        <p class="mb-1"><strong>DL No:</strong> @Model?.DrivingLicenceNumber</p>
                        <p class="mb-1"><strong>DL Issue:</strong> @Model?.DLIssueDate</p>
                        <p class="mb-0"><strong>DL Expiry:</strong> @Model?.DLExpiryDate</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <div class="alert alert-info">
                Staff can view customer information only. Updates/removals are restricted.
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>