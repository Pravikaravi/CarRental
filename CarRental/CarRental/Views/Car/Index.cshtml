@model IEnumerable<CarRental.Models.Car>

@{
    ViewData["Title"] = "Car Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #0B1225, #1E293B, #334155);
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .car-dashboard {
        padding: 30px;
    }

    h1 {
        color: #0fc0fc;
        margin-bottom: 20px;
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0B1225;
        padding: 15px 30px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 0 10px rgba(15,192,252,0.3);
        flex-wrap: wrap;
    }

    .nav-left a {
        margin-right: 20px;
        color: #0fc0fc;
        text-decoration: none;
        font-weight: bold;
        transition: color 0.3s;
    }

        .nav-left a:hover {
            color: #38bdf8;
        }

    .nav-right input {
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid #444;
        background: #1E293B;
        color: white;
        width: 250px;
    }

    .add-btn {
        padding: 10px 20px;
        background: #0fc0fc;
        color: #0B1225;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .add-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px #0fc0fc;
        }

    .car-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: rgba(255,255,255,0.05);
        border-radius: 12px;
        overflow: hidden;
    }

        .car-table th, .car-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #444;
        }

        .car-table th {
            background-color: #0B1225;
            color: #0fc0fc;
        }

        .car-table tr:hover {
            background: rgba(255,255,255,0.1);
        }

    .action-buttons a {
        margin-right: 6px;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-warning {
        background-color: #facc15;
        color: #0B1225;
    }

    .btn-info {
        background-color: #38bdf8;
        color: #0B1225;
    }

    .btn-danger {
        background-color: #ef4444;
        color: #fff;
    }

    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        backdrop-filter: blur(6px);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background: #1E293B;
        padding: 30px;
        border-radius: 15px;
        width: 420px;
        color: white;
        box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        animation: fadeIn 0.3s ease;
    }

        .modal-content h2 {
            margin-bottom: 15px;
            color: #0fc0fc;
            font-size: 22px;
        }

        .modal-content label {
            display: block;
            margin: 10px 0 5px;
            font-weight: bold;
            font-size: 14px;
        }

        .modal-content input,
        .modal-content select {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #444;
            background: #0B1225;
            color: white;
            margin-bottom: 12px;
        }

        .modal-content button {
            margin-top: 10px;
            padding: 12px;
            width: 100%;
            border: none;
            border-radius: 8px;
            background: #0fc0fc;
            color: #0B1225;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }

            .modal-content button:hover {
                transform: scale(1.05);
                box-shadow: 0 0 12px #0fc0fc;
            }

    .close-btn {
        float: right;
        cursor: pointer;
        font-size: 22px;
        color: #aaa;
    }

        .close-btn:hover {
            color: #fff;
        }

    @@keyframes fadeIn {
        from {
            transform: scale(0.9);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@media screen and (max-width: 480px) {
        .modal-content {
            width: 90%;
            padding: 20px;
        }

        .nav-right input {
            width: 100%;
            margin-top: 10px;
        }

        .navbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .nav-left, .nav-right {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>

<div class="car-dashboard">
    <h1>Car Management</h1>

    <nav class="navbar">
        <div class="nav-left">
            <a href="#" onclick="reloadCars()"><i class="fa fa-table"></i> View All Cars</a>
            <a href="#" onclick="openModal()"><i class="fa fa-plus-circle"></i> Add Car</a>
        </div>
        <div class="nav-right">
            <input type="text" id="searchInput" placeholder="Search by name or brand..." onkeyup="filterCars()" />
        </div>
    </nav>

    <table class="car-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Car Name</th>
                <th>Brand</th>
                <th>Color</th>
                <th>Seats</th>
                <th>Rental (Rs.)</th>
                <th>Status</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(car.ImageUrl))
                        {
                            <img src="@car.ImageUrl" alt="Car Image" style="width:80px; height:50px; object-fit:cover; border-radius:5px;" />
                        }
                    </td>
                    <td>@car.CarName</td>
                    <td>@car.CarBrand</td>
                    <td>@car.CarColor</td>
                    <td>@car.CarSeats</td>
                    <td>@car.CarRentalAmount</td>
                    <td>@car.CarStatus</td>
                    <td>@(car.IsAvailable ? "Yes" : "No")</td>
                    <td class="action-buttons">
                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-warning">
                            <i class="fa fa-edit"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-sm btn-info">
                            <i class="fa fa-info-circle"></i> Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this car?');">
                            <i class="fa fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>


<!-- ===== Modal for Add Car ===== -->
<div id="addCarModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal()">&times;</span>
        <h2>Add New Car</h2>

        <form asp-action="Create" asp-controller="Car" method="post" enctype="multipart/form-data">
            <label>Car Name</label>
            <input type="text" name="CarName" required />

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <div style="flex:1;">
                    <label>Brand</label>
                    <input type="text" name="CarBrand" required />
                </div>
                <div style="flex:1;">
                    <label>Color</label>
                    <input type="text" name="CarColor" required />
                </div>
            </div>

            <label>Car Number</label>
            <input type="text" name="CarNumber" required />

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <div style="flex:1;">
                    <label>Seats</label>
                    <input type="number" name="CarSeats" required />
                </div>
                <div style="flex:1;">
                    <label>Rental Amount ($)</label>
                    <input type="number" name="CarRentalAmount" step="0.01" required />
                </div>
            </div>

            <label>Status</label>
            <select name="CarStatus" required>
                <option value="Pending">Pending</option>
                <option value="Cancelled">Cancelled</option>
                <option value="On-Going">On-Going</option>
                <option value="Returned">Returned</option>
                <option value="Overdue">Overdue</option>
                <option value="Completed">Completed</option>
            </select>

            <label>Upload Car Image</label>
            <input type="file" name="CarImage" accept="image/*" required />

            <label>Available</label>
            <select name="IsAvailable">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>

            <button type="submit">Save Car</button>
        </form>
    </div>
</div>


<script>
    function openModal() {
        document.getElementById("addCarModal").style.display = "flex";
    }

    function closeModal() {
        document.getElementById("addCarModal").style.display = "none";
    }

    function filterCars() {
        const input = document.getElementById("searchInput").value.toLowerCase();
        const rows = document.querySelectorAll(".car-table tbody tr");

        rows.forEach(row => {
            const name = row.children[1]?.textContent.toLowerCase();
            const brand = row.children[2]?.textContent.toLowerCase();
            row.style.display = (name.includes(input) || brand.includes(input)) ? "" : "none";
        });
    }

    function reloadCars() {
        document.getElementById("searchInput").value = "";
        filterCars();
    }
</script>
