@model IEnumerable<CarRental.Models.Car>

@{
    ViewData["Title"] = "Car Management";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .car-dashboard {
        padding: 20px;
    }

    .car-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        overflow: hidden;
    }

        .car-table th, .car-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #444;
        }

        .car-table th {
            background-color: #0B1225;
            color: #0fc0fc;
        }

    .action-links a {
        margin-right: 10px;
        color: #0fc0fc;
        text-decoration: none;
        font-size: 0.9em;
    }

        .action-links a:hover {
            text-decoration: underline;
        }

    .btn-create {
        padding: 10px 20px;
        background: #0fc0fc;
        color: #0B1225;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
        text-decoration: none;
    }

        .btn-create:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px #0fc0fc;
        }
</style>

<div class="car-dashboard">
    <h1>Car Management</h1>

    <a asp-action="Create" asp-controller="Car" class="btn-create">
        <i class="fa fa-plus"></i> Add New Car
    </a>

    <table class="car-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Car Name</th>
                <th>Brand</th>
                <th>Color</th>
                <th>Seats</th>
                <th>Available</th>
                <th>Actions</th> <!-- ✅ Added Actions column -->
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(car.ImageUrl))
                        {
                            <img src="@car.ImageUrl" alt="Car Image" style="width:80px; height:50px; object-fit:cover; border-radius:5px;" />
                        }
                    </td>
                    <td>@car.CarName</td>
                    <td>@car.CarBrand</td>
                    <td>@car.CarColor</td>
                    <td>@car.CarSeats</td>
                    <td>@(car.IsAvailable ? "Yes" : "No")</td>
                    <td class="action-links">
                        <a asp-action="Details" asp-route-id="@car.Id"><i class="fa fa-eye"></i> Details</a>
                        <a asp-action="Edit" asp-route-id="@car.Id"><i class="fa fa-edit"></i> Edit</a>
                        <a asp-action="Delete" asp-route-id="@car.Id"><i class="fa fa-trash"></i> Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
