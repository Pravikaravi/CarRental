@model CarRental.Models.Car
@{
    ViewBag.Title = "Edit Car";
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #0B1225, #1E293B, #334155);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
        animation: fadeIn 0.6s ease-in-out;
    }

    .container {
        max-width: 800px;
        margin: 50px auto;
        padding: 20px;
    }

    h2 {
        color: #0fc0fc;
        text-align: center;
        font-size: 28px;
        margin-bottom: 30px;
        animation: slideDown 0.6s ease;
    }

    .card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid #0fc0fc;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 0 25px rgba(15, 192, 252, 0.3);
        animation: fadeUp 0.6s ease;
    }

    .form-label {
        font-weight: bold;
        color: #0fc0fc;
        margin-bottom: 6px;
        display: block;
    }

    .form-control, .form-select {
        background-color: #0B1225;
        color: #fff;
        border: 1px solid #444;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 20px;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0fc0fc;
            box-shadow: 0 0 10px #0fc0fc;
        }

    .car-image-preview {
        display: block;
        margin: 20px auto;
        width: 100%;
        max-width: 400px;
        height: 250px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #0fc0fc;
        box-shadow: 0 0 15px rgba(15, 192, 252, 0.4);
        transition: transform 0.3s ease;
    }

        .car-image-preview:hover {
            transform: scale(1.05);
        }

    .btn-warning {
        background-color: #facc15;
        color: #0B1225;
        font-weight: bold;
        border-radius: 10px;
        padding: 12px 24px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .btn-warning:hover {
            transform: scale(1.05);
            box-shadow: 0 0 12px #facc15;
        }

    .btn-secondary {
        background-color: #64748b;
        color: #fff;
        font-weight: bold;
        border-radius: 10px;
        padding: 12px 24px;
        margin-left: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .btn-secondary:hover {
            transform: scale(1.05);
            box-shadow: 0 0 12px #64748b;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideDown {
        from {
            transform: translateY(-20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@keyframes fadeUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }


    }
</style>

<div class="container">
    <h2><i class="fa fa-edit"></i> Edit Car</h2>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="card">
        <input type="hidden" asp-for="Id" />

        <label class="form-label">Car Name</label>
        <input asp-for="CarName" class="form-control" required />

        <label class="form-label">Brand</label>
        <input asp-for="CarBrand" class="form-control" required />

        <label class="form-label">Color</label>
        <input asp-for="CarColor" class="form-control" required />

        <label class="form-label">Car Number</label>
        <input asp-for="CarNumber" class="form-control" required />

        <label class="form-label">Seats</label>
        <input asp-for="CarSeats" type="number" class="form-control" required />

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <label class="form-label">Current Image</label>
            <img src="@Model.ImageUrl" alt="Car Image" class="car-image-preview" />
        }

        <label class="form-label">Upload New Image (optional)</label>
        <input type="file" name="CarImage" class="form-control" accept="image/*" />

        <label class="form-label">Available</label>
        <select asp-for="IsAvailable" class="form-select">
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>

        <div class="d-flex justify-content-center mt-4">
            <button type="submit" class="btn btn-warning">
                <i class="fa fa-save"></i> Update Car
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>
