@model CarRental.Models.Car

@{
    ViewBag.Title = "Delete Car";
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        background-color: #0B1225;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
        padding: 40px;
    }

    h2 {
        color: #0fc0fc;
        text-align: center;
        margin-bottom: 20px;
    }

    .confirm-box {
        background-color: #1E293B;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(15, 192, 252, 0.3);
        max-width: 600px;
        margin: auto;
        text-align: center;
    }

    .btn-danger {
        background-color: #ef4444;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        margin-right: 10px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #dc2626;
            transform: scale(1.05);
        }

    .btn-secondary {
        background-color: #334155;
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal-content {
        background-color: #1E293B;
        padding: 30px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 0 20px #0fc0fc;
        animation: popIn 0.4s ease;
    }

        .modal-content h3 {
            color: #0fc0fc;
            margin-bottom: 20px;
        }

    .toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background-color: #0fc0fc;
        color: #0B1225;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: bold;
        display: none;
        animation: fadeIn 0.5s ease;
        z-index: 1000;
    }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            bottom: 10px;
        }

        to {
            opacity: 1;
            bottom: 30px;
        }
    }
</style>

<h2>Delete Car</h2>
<div class="confirm-box">
    <h3>Are you sure you want to delete this car?</h3>
    <p><strong>@Model.CarName</strong> - @Model.CarBrand</p>
    <button class="btn-danger" onclick="showModal()">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
</div>

<!-- Modal -->

<div class="modal-overlay" id="deleteModal">
    <div class="modal-content">
        <h3>Confirm Permanent Deletion</h3>
        <p>This action cannot be undone.</p>
        @using (Html.BeginForm("Delete", "Car", FormMethod.Post, new { id = "deleteForm" }))

        {
            @Html.AntiForgeryToken()
            <button type="button" class="btn-danger" onclick="confirmDelete()">Confirm Delete</button>
        }
        <br /><br />
        <button class="btn-secondary" onclick="closeModal()">Cancel</button>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toastMessage">Car deleted successfully!</div>

<script>
    function showModal() {
        document.getElementById('deleteModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }

    function confirmDelete() {
        const toast = document.getElementById('toastMessage');
        toast.style.display = 'block';

        setTimeout(() => {
            toast.style.display = 'none';
            document.getElementById('deleteForm').submit();
        }, 1500); // Delay before form submission
    }
</script>
