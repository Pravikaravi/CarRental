@model CarRental.Models.Car

@{
    ViewBag.Title = "Car Details";
    Layout = null;
}

<style>
    body {
        background: linear-gradient(135deg, #0B1225, #1E293B);
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
        padding: 40px;
        animation: fadeIn 0.8s ease-in-out;
    }

    .details-container {
        max-width: 750px;
        margin: auto;
        background-color: #1E293B;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 0 25px rgba(15, 192, 252, 0.3);
        animation: slideUp 0.8s ease;
    }

    h2 {
        color: #0fc0fc;
        text-align: center;
        font-size: 30px;
        margin-bottom: 25px;
        animation: fadeIn 1s ease;
    }

    .detail-row {
        opacity: 0;
        animation: fadeDetail 0.6s ease forwards;
        animation-delay: var(--delay);
        margin: 12px 0;
        border-bottom: 1px solid #334155;
        padding-bottom: 6px;
    }

        .detail-row strong {
            color: #0fc0fc;
            margin-right: 10px;
        }

    .car-image {
        display: block;
        margin: 30px auto;
        width: 100%;
        max-width: 650px;
        height: 380px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(15, 192, 252, 0.4);
        animation: zoomPulse 1.2s ease-in-out;
    }

    .availability {
        display: inline-block;
        background-color: @(Model.IsAvailable ? "#0fc0fc" : "#ef4444");
        color: #0B1225;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: bold;
        animation: bounceIn 0.6s ease;
    }

    .btn-primary {
        background-color: #0fc0fc;
        color: #0B1225;
        font-weight: bold;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: rotate(-1deg) scale(1.05);
            box-shadow: 0 0 12px #0fc0fc;
        }

    /* Keyframes */
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(40px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@keyframes fadeDetail {
        to {
            opacity: 1;
            transform: translateY(0);
        }

        from {
            opacity: 0;
            transform: translateY(20px);
        }
    }

    @@keyframes zoomPulse {
        0% {
            transform: scale(0.95);
            opacity: 0;
        }

        50% {
            transform: scale(1.02);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes bounceIn {
        0% {
            transform: scale(0.5);
            opacity: 0;
        }

        60% {
            transform: scale(1.2);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }
</style>

<div class="details-container">
    <h2>Car Details</h2>

    <p class="detail-row" style="--delay:0.2s"><strong>Name:</strong> @Model.CarName</p>
    <p class="detail-row" style="--delay:0.3s"><strong>Brand:</strong> @Model.CarBrand</p>
    <p class="detail-row" style="--delay:0.4s"><strong>Color:</strong> @Model.CarColor</p>
    <p class="detail-row" style="--delay:0.5s"><strong>Seats:</strong> @Model.CarSeats</p>
    <p class="detail-row" style="--delay:0.6s"><strong>Number:</strong> @Model.CarNumber</p>
    <p class="detail-row" style="--delay:0.7s">
        <strong>Available:</strong> <span class="availability">@((Model.IsAvailable ? "Yes" : "No"))</span>
    </p>

    <img src="@Model.ImageUrl" alt="Car Image" class="car-image" />

    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
</div>
