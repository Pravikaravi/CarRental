@model IEnumerable<CarRental.Models.Banner>

<h2>Banners</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Add Banner</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Image</th>
            <th>Created At</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var banner in Model)
        {
            <tr>
                <td>@banner.Title</td>
                <td><img src="@banner.ImageUrl" width="200" /></td>
                <td>@banner.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@banner.Id" class="btn btn-danger"
                       onclick="return confirm('Are you sure you want to delete this banner?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
